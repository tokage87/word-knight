    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.82",
    "phaser": "^3.87.0"
